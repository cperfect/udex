// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
	"name": "Rust",
	// Use Docker Compose for development environment
	"dockerComposeFile": [
		"docker-compose.devcontainer.yml",
		"../projects/compose/docker-compose.yml"
	],
	"service": "devcontainer",
	"workspaceFolder": "/workspace",
	"remoteEnv": {
		"RUST_BACKTRACE": "1",
		// info globally; debug for udex crates only. Set to "trace" locally for full output.
		"RUST_LOG": "info,udex=debug"
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/devcontainers-extra/features/protoc:1": {},
		"ghcr.io/warrenbuckley/codespace-features/sqlite:1": {},
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers-extra/features/claude-code:1": {},
		"ghcr.io/guiyomh/features/vim:0": {}
	},

	// Use 'mounts' to make the cargo cache persistent in a Docker Volume.
	// "mounts": [
	// 	{
	// 		"source": "devcontainer-cargo-cache-${devcontainerId}",
	// 		"target": "/usr/local/cargo",
	// 		"type": "volume"
	// 	}
	// ]

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [
		4444, // Hydra
		4445, // Hydra Admin
		5432  // Postgres
	],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "./.devcontainer/post-create.sh"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
